---
import Bab from './Bab.astro';
import { usaha, kota, jam, tampil } from '../data/site';

// ponytail: proyeksi datar lokal (1° lintang = 110,57 km; 1° bujur = 111,32·cos lintang km).
// Cukup untuk < 150 km; pakai haversine bila jangkauan lebih jauh.
const piksel = 2.5; // px per km; lingkar terluar 100 km = 250 px
const kmBujur = 111.32 * Math.cos((usaha.titik.lat * Math.PI) / 180);
const titik = kota.map((k) => {
  const dx = (k.lon - usaha.titik.lon) * kmBujur;
  const dy = (k.lat - usaha.titik.lat) * 110.57;
  return { nama: k.nama, jarak: Math.round(Math.hypot(dx, dy)), x: dx * piksel, y: -dy * piksel };
});
const ringkas = titik.map((t) => `${t.nama} ${t.jarak} km`).join(', ');
---

<Bab id="lokasi" seed={8} tema="gelap">
  <h2 class="tipe-bab max-w-[20ch]">Basis di Gresik. Jangkauan Jawa Timur.</h2>

  <div class="mt-12 grid gap-x-16 gap-y-16 md:mt-16 lg:grid-cols-12 lg:items-start">
    <figure class="lg:col-span-7">
      <svg viewBox="-330 -280 660 560" role="img" aria-label={`Jarak garis lurus dari Gresik: ${ringkas}`} class="w-full">
        <g fill="none" class="stroke-kabut" stroke-width="1.2">
          <circle r="62.5" stroke-dasharray="3 5"></circle>
          <circle r="125" stroke-dasharray="3 5"></circle>
          <circle r="250"></circle>
          <path d="M-262 0H262M0 -262V262" opacity="0.45"></path>
        </g>
        <g style="font:600 var(--fs-peta-kecil) var(--font-sans)" class="fill-kabut">
          <text x="48" y="-48">25 km</text>
          <text x="92" y="-92">50 km</text>
          <text x="181" y="-181">100 km</text>
        </g>
        <g style="font:800 22px var(--font-display)" class="fill-semen" text-anchor="middle">
          <text x="0" y="-268">U</text>
          <text x="272" y="8">T</text>
          <text x="0" y="278">S</text>
          <text x="-272" y="8">B</text>
        </g>
        {
          titik.map((t) => {
            const kiri = t.x < -40;
            return (
              <g>
                <circle cx={t.x} cy={t.y} r="5" class="fill-semen"></circle>
                <text
                  x={t.x + (kiri ? -11 : 11)}
                  y={t.y + 5}
                  text-anchor={kiri ? 'end' : 'start'}
                  style="font:600 var(--fs-peta) var(--font-sans)"
                  class="fill-semen"
                >
                  {t.nama} <tspan class="fill-kabut" font-weight="400">{t.jarak} km</tspan>
                </text>
              </g>
            );
          })
        }
        <circle r="14" fill="none" class="stroke-resin" stroke-width="3"></circle>
        <circle r="5" class="fill-resin"></circle>
        <text x="-16" y="30" text-anchor="end" style="font:800 24px var(--font-display)" class="fill-resin">GRESIK</text>
      </svg>
      <figcaption class="mt-3 max-w-[60ch] text-kecil text-kabut">
        Jarak garis lurus dari pusat kota Gresik ke kota tujuan, digambar sesuai skala. Jarak lewat jalan lebih jauh.
      </figcaption>
    </figure>

    <div class="lg:col-span-5">
      <h3 class="font-display text-4xl font-extrabold leading-none">Kantor</h3>
      <p class="mt-4 text-[1.25rem]">{tampil.alamat}</p>
      <p class="mt-2 max-w-[46ch] text-kecil text-kabut">
        Pekerjaan lapangan menjangkau seluruh Jawa Timur. Proyek di luar provinsi dibahas per proyek.
      </p>

      <h3 class="mt-14 font-display text-4xl font-extrabold leading-none">Jam kerja</h3>
      <table class="mt-4 w-full">
        <tbody>
          {
            jam.map((j) => (
              <tr
                data-hari={j.hari.join(' ')}
                class="border-t-2 border-kabut/40 aria-[current=date]:bg-resin aria-[current=date]:text-beton-dalam"
              >
                <th scope="row" class="px-3 py-3 text-left font-normal">
                  {j.nama}
                </th>
                <td class="whitespace-nowrap px-3 py-3 text-right font-semibold tabular-nums">{j.waktu}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="mt-4 max-w-[46ch] text-kecil text-kabut">
        Semua jam dalam WIB. Di luar jam kerja, pesan WhatsApp tetap dibaca dan dibalas pada hari kerja berikutnya.
        Inspeksi lapangan bisa dijadwalkan di luar jam ini.
      </p>
    </div>
  </div>
</Bab>

<script>
  // Tandai baris hari ini menurut WIB, berapa pun zona waktu pengunjung.
  const hari = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Jakarta' })).getDay();
  document.querySelectorAll<HTMLElement>('[data-hari]').forEach((r) => {
    if (r.dataset.hari?.split(' ').includes(String(hari))) r.setAttribute('aria-current', 'date');
  });
</script>
