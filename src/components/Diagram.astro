---
// Lima gambar teknik (SVG buatan sendiri) untuk lima layanan. Skema, bukan skala.
interface Props {
  nama: 'perbaikan' | 'perkuatan' | 'injeksi' | 'waterproofing' | 'inspeksi';
  judul: string;
}
const { nama, judul } = Astro.props;
---

<svg viewBox="0 0 480 340" role="img" aria-label={judul} class="w-full">
  {
    nama === 'perbaikan' && (
      <>
        <rect x="40" y="70" width="400" height="230" fill="url(#p-beton)" class="stroke-semen" stroke-width="2" />
        <path d="M70 70H250L262 100L248 132L215 158L160 168L110 150L78 118Z" class="fill-beton-dalam" />
        <path d="M70 70H250L262 100L248 132L215 158L160 168L110 150L78 118Z" fill="url(#p-resin)" class="stroke-resin" stroke-width="2.5" stroke-linejoin="round" />
        <circle cx="150" cy="112" r="20" class="fill-beton-dalam" />
        <circle cx="150" cy="112" r="16" fill="none" class="stroke-resin" stroke-width="1.8" stroke-dasharray="4 3" />
        <circle cx="150" cy="112" r="9" class="fill-beton-dalam stroke-semen" stroke-width="2.5" />
        <path d="M336 70H368L352 104Z" fill="url(#p-resin)" class="stroke-resin" stroke-width="2" stroke-linejoin="round" />
        <path d="M352 104L347 140L355 182L349 232" fill="none" class="stroke-semen" stroke-width="1.6" />
        <g fill="none" class="stroke-kabut" stroke-width="1.2">
          <path d="M150 121H300M160 168H300" stroke-dasharray="3 3" />
          <path d="M292 122V168" class="stroke-semen" stroke-width="1.6" />
        </g>
        <path d="M292 122l-4 9h8zM292 168l-4-9h8z" class="fill-semen" />
        <rect x="300" y="134" width="84" height="24" class="fill-beton-dalam" />
        <g style="font:600 15px var(--font-sans)" class="fill-semen">
          <text x="306" y="151">± 20 mm</text>
          <text x="44" y="26">mortar perbaikan</text>
          <text x="170" y="54">tulangan + primer anti-karat</text>
          <text x="336" y="26">alur V + sealant</text>
          <text x="44" y="326">beton sehat</text>
        </g>
        <g fill="none" class="stroke-kabut" stroke-width="1.2">
          <path d="M100 32L120 90M200 60L162 104M380 32L356 84M100 312L110 276" />
        </g>
      </>
    )
  }
  {
    nama === 'perkuatan' && (
      <>
        <rect x="140" y="55" width="200" height="200" rx="16" fill="none" class="stroke-resin" stroke-width="8" />
        <rect x="152" y="67" width="176" height="176" rx="6" fill="url(#p-beton)" class="stroke-semen" stroke-width="1.5" />
        <rect x="178" y="93" width="124" height="124" rx="5" fill="none" class="stroke-semen" stroke-width="2.5" />
        <g class="fill-beton-dalam stroke-semen" stroke-width="2">
          <circle cx="188" cy="103" r="9" /><circle cx="292" cy="103" r="9" />
          <circle cx="188" cy="207" r="9" /><circle cx="292" cy="207" r="9" />
        </g>
        <g fill="none" class="stroke-resin" stroke-width="2.4">
          <path d="M240 24V44M234 38l6 8 6-8" />
          <path d="M240 288V268M234 274l6-8 6 8" />
          <path d="M112 155H132M126 149l8 6-8 6" />
          <path d="M368 155H348M354 149l-8 6 8 6" />
        </g>
        <g style="font:600 15px var(--font-sans)" class="fill-semen">
          <text x="368" y="72">lembar CFRP</text>
          <text x="368" y="136">sengkang</text>
          <text x="368" y="240">tulangan utama</text>
          <text x="10" y="40">sudut dibulatkan</text>
          <text x="10" y="316">beton lama</text>
          <text x="10" y="158">tekanan</text>
          <text x="10" y="174">kekang</text>
        </g>
        <g fill="none" class="stroke-kabut" stroke-width="1.2">
          <path d="M338 66L364 68M302 130L364 132M300 212L364 236M60 46L146 62M60 312L170 226" />
        </g>
      </>
    )
  }
  {
    nama === 'injeksi' && (
      <>
        <g transform="translate(-24 0)">
          <rect x="110" y="40" width="260" height="270" fill="url(#p-beton)" class="stroke-semen" stroke-width="2" />
          <path d="M240 40L233 90L248 140L236 190L247 240L240 310" fill="none" class="stroke-resin" stroke-width="16" opacity="0.28" stroke-linejoin="round" />
