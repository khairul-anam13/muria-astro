          <path d="M240 310L247 240L236 190L242 165" fill="none" class="stroke-resin" stroke-width="3.5" stroke-linejoin="round" />
          <g class="fill-beton-dalam stroke-semen" stroke-width="2">
            <circle cx="233" cy="90" r="10" /><circle cx="248" cy="140" r="10" /><circle cx="236" cy="190" r="10" />
            <circle cx="247" cy="240" r="10" /><circle cx="241" cy="290" r="10" />
          </g>
          <g stroke="none">
            <circle cx="233" cy="90" r="3.5" class="fill-kabut" /><circle cx="248" cy="140" r="3.5" class="fill-kabut" />
            <circle cx="236" cy="190" r="3.5" class="fill-resin" /><circle cx="247" cy="240" r="3.5" class="fill-resin" /><circle cx="241" cy="290" r="3.5" class="fill-resin" />
          </g>
        </g>
        <path d="M227 290C270 290 300 306 350 306" fill="none" class="stroke-semen" stroke-width="3" />
        <path d="M350 294h50l14 12-14 12h-50z" class="fill-resin" />
        <path d="M366 262V124" fill="none" class="stroke-resin" stroke-width="2.6" stroke-dasharray="7 5" />
        <path d="M366 112l-7 14h14z" class="fill-resin" />
        <g style="font:600 15px var(--font-sans)" class="fill-semen">
          <text x="10" y="94">packer</text>
          <text x="10" y="150">segel</text>
          <text x="10" y="166">permukaan</text>
          <text x="10" y="222">retak</text>
          <text x="378" y="172">injeksi dari</text>
          <text x="378" y="190">bawah ke atas</text>
          <text x="350" y="336">pompa injeksi</text>
        </g>
        <g fill="none" class="stroke-kabut" stroke-width="1.2">
          <path d="M56 90H197M84 158L212 147M46 218L208 209" />
        </g>
      </>
    )
  }
  {
    nama === 'waterproofing' && (
      <>
        <rect x="40" y="210" width="290" height="100" fill="url(#p-beton)" class="stroke-semen" stroke-width="2" />
        <path d="M230 210L224 245L234 275L228 310" fill="none" class="stroke-beton-dalam" stroke-width="3.5" />
        <rect x="40" y="200" width="290" height="10" class="fill-semen" opacity="0.55" />
        <rect x="40" y="176" width="290" height="24" class="fill-resin" />
        <path d="M40 188H330" fill="none" class="stroke-beton-dalam" stroke-width="1.4" stroke-dasharray="7 4" />
        <rect x="40" y="136" width="290" height="40" class="fill-semen stroke-semen" fill-opacity="0.14" stroke-width="1.5" />
        <g class="fill-semen">
          <path d="M75 44c5 8 8 13 0 18-8-5-5-10 0-18zM135 74c5 8 8 13 0 18-8-5-5-10 0-18zM195 40c5 8 8 13 0 18-8-5-5-10 0-18zM265 70c5 8 8 13 0 18-8-5-5-10 0-18z" />
        </g>
        <g fill="none" class="stroke-semen" stroke-width="1.6" stroke-dasharray="4 5">
          <path d="M75 68V128M135 98V128M195 64V128M265 94V128" />
        </g>
        <path d="M230 142V170M218 174H242" fill="none" class="stroke-resin" stroke-width="3" />
        <g style="font:600 15px var(--font-sans)" class="fill-semen">
          <text x="342" y="160">screed pelindung</text>
          <text x="342" y="186">membran cair</text>
          <text x="342" y="204">+ kain penguat</text>
          <text x="342" y="230">primer</text>
          <text x="342" y="268">beton dak</text>
          <text x="286" y="58">air hujan</text>
          <text x="244" y="162">tertahan</text>
        </g>
        <g fill="none" class="stroke-kabut" stroke-width="1.2">
          <path d="M330 156H338M330 190H338M330 205L338 226M330 262H338" />
        </g>
      </>
    )
  }
  {
    nama === 'inspeksi' && (
      <>
        <rect x="40" y="44" width="400" height="186" class="fill-semen stroke-semen" fill-opacity="0.07" stroke-width="2" />
        <path d="M140 44V230M240 44V230M340 44V230M40 106H440M40 168H440" fill="none" class="stroke-kabut" stroke-width="1" stroke-dasharray="4 4" />
        <path d="M40 60L120 96L160 132L250 152L300 190L440 206" fill="none" class="stroke-beton-dalam" stroke-width="7" stroke-linejoin="round" />
        <path d="M40 60L120 96L160 132L250 152L300 190L440 206" fill="none" class="stroke-semen" stroke-width="2.6" stroke-linejoin="round" />
        <g class="fill-beton-dalam stroke-semen" stroke-width="2">
          <circle cx="90" cy="75" r="11" /><circle cx="190" cy="75" r="11" /><circle cx="290" cy="75" r="11" /><circle cx="390" cy="75" r="11" />
          <circle cx="90" cy="137" r="11" /><circle cx="190" cy="137" r="11" /><circle cx="290" cy="137" r="11" /><circle cx="390" cy="137" r="11" />
          <circle cx="90" cy="199" r="11" /><circle cx="190" cy="199" r="11" /><circle cx="290" cy="199" r="11" /><circle cx="390" cy="199" r="11" />
        </g>
        <g style="font:600 12px var(--font-sans)" class="fill-semen" text-anchor="middle">
          <text x="90" y="79">1</text><text x="190" y="79">2</text><text x="290" y="79">3</text><text x="390" y="79">4</text>
          <text x="90" y="141">5</text><text x="190" y="141">6</text><text x="290" y="141">7</text><text x="390" y="141">8</text>
          <text x="90" y="203">9</text><text x="190" y="203">10</text><text x="290" y="203">11</text><text x="390" y="203">12</text>
        </g>
        <g class="fill-semen stroke-beton-dalam" stroke-width="2">
          <path d="M100 100h52v22h-52z" /><path d="M300 172h52v22h-52z" />
        </g>
        <g style="font:900 16px var(--font-stensil)" class="fill-beton-dalam">
          <text x="107" y="117">R-01</text><text x="307" y="189">R-02</text>
        </g>
        <rect x="40" y="252" width="400" height="76" class="fill-semen" />
        <g class="fill-beton-dalam">
          <rect x="72" y="262" width="2" height="30" /><rect x="138.5" y="262" width="3" height="30" /><rect x="204.8" y="262" width="4.5" height="30" />
          <rect x="269.7" y="262" width="6.5" height="30" /><rect x="335.5" y="262" width="9" height="30" /><rect x="401" y="262" width="12" height="30" />
        </g>
        <g style="font:600 13px var(--font-sans)" class="fill-beton-dalam" text-anchor="middle">
          <text x="73" y="308">0,1</text><text x="140" y="308">0,2</text><text x="207" y="308">0,3</text>
          <text x="273" y="308">0,5</text><text x="340" y="308">0,8</text><text x="407" y="308">1,0</text>
        </g>
        <g style="font:600 15px var(--font-sans)" class="fill-semen">
          <text x="40" y="30">titik uji rebound hammer</text>
          <text x="440" y="246" text-anchor="end">kartu retak, lebar dalam mm (skema)</text>
        </g>
      </>
    )
  }
</svg>
