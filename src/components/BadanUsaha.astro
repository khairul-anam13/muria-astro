---
import Bab from './Bab.astro';
import Simpul from './Simpul.astro';
import { legalitas, organisasi } from '../data/site';
---

<Bab id="badan-usaha" seed={7} tema="terang">
  <h2 class="tipe-bab max-w-[20ch]">Berkas lengkap. Orang yang jelas.</h2>

  <div class="mt-12 grid gap-x-16 gap-y-16 md:mt-16 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <h3 class="font-display text-4xl font-extrabold leading-none">Legalitas</h3>
      <ul class="mt-6 border-t-4 border-beton-tua">
        {
          legalitas.map((l) => (
            <li class="flex gap-4 border-b border-beton-tua/40 py-5">
              <svg viewBox="0 0 24 24" class="mt-1 size-6 shrink-0" fill="none" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" class="stroke-beton-tua" stroke-width="3" />
                <path d="M6.5 12.5l4 4 7.5-9" class="stroke-beton-tua" stroke-width="3" />
              </svg>
              <div>
                <p class="font-display text-3xl font-bold leading-none">{l.nama}</p>
                <p class="mt-1 max-w-[44ch]">{l.isi}</p>
              </div>
            </li>
          ))
        }
      </ul>
      <p class="mt-5 max-w-[44ch] text-kecil">
        Salinan dokumen bisa diminta untuk kelengkapan penawaran atau prakualifikasi.
      </p>
    </div>

    <div class="lg:col-span-7">
      <h3 class="font-display text-4xl font-extrabold leading-none">Struktur organisasi</h3>
      <ol class="mt-6 border-t-4 border-beton-tua pt-3">
        <Simpul n={organisasi} akar />
      </ol>
    </div>
  </div>
</Bab>
