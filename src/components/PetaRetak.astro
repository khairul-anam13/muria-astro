---
// Denah lantai contoh dengan retak yang sudah diinjeksi. Panjang tiap retak diambil dari data
// berita acara yang sama, jadi gambar dan tabel tidak bisa saling bertentangan.
import { retak, lebar } from '../lib/retak';
import type { Pt } from '../lib/retak';
import { beritaAcara } from '../data/site';

const M = 60; // 1 m = 60 satuan gambar; lantai 6 × 4 m
const susun: Record<string, { dari: Pt; sudut: number; seed: number; plat: Pt }> = {
  'R-01': { dari: [210, 45], sudut: 90, seed: 4, plat: [230, 96] }, // menyusuri sambungan susut
  'R-02': { dari: [55, 72], sudut: 35, seed: 8, plat: [104, 62] },
  'R-03': { dari: [60, 250], sudut: -1, seed: 15, plat: [96, 214] },
  'R-04': { dari: [330, 60], sudut: 100, seed: 22, plat: [262, 64] },
};
const garis = beritaAcara.map((r) => {
  const c = susun[r.id];
  const rad = (c.sudut * Math.PI) / 180;
  const p = (r.panjang * M) / 1.03; // garis berkelok sedikit lebih panjang dari jarak lurusnya
  const ke: Pt = [c.dari[0] + Math.cos(rad) * p, c.dari[1] + Math.sin(rad) * p];
  const titik = retak(c.seed, c.dari, ke, Math.max(5, Math.round(r.panjang * 2.4)), 4);
  return { id: r.id, titik, packer: titik.filter((_, i) => i > 0 && i < titik.length - 1 && i % 2 === 0), plat: c.plat };
});
---

<figure class="max-w-[44rem]">
  <svg
    viewBox="0 0 420 330"
    role="img"
    aria-label="Denah lantai gudang 6 kali 4 meter berisi empat retak R-01 sampai R-04 yang sudah diinjeksi, masing-masing dengan packer"
    class="w-full"
  >
    <rect x="30" y="30" width="360" height="240" class="fill-semen stroke-beton-tua" stroke-width="3"></rect>
    <path d="M210 30V270" fill="none" class="stroke-debu" stroke-width="1.6" stroke-dasharray="10 4 2 4"></path>
    {
      garis.map(({ titik, packer }, i) => (
        <>
          <path d={lebar(titik, 8, i + 3)} class="fill-beton-dalam"></path>
          <path d={lebar(titik, 4, i + 3)} class="fill-resin"></path>
          {packer.map(([x, y]) => (
            <circle cx={x} cy={y} r="4.5" class="fill-beton-dalam stroke-semen" stroke-width="1.5"></circle>
          ))}
        </>
      ))
    }
    {
      garis.map(({ id, plat: [x, y], titik }) => {
        // garis penunjuk dari pelat ke titik retak terdekat
        const [tx, ty] = titik.reduce((a, b) => (Math.hypot(b[0] - x - 24, b[1] - y - 11) < Math.hypot(a[0] - x - 24, a[1] - y - 11) ? b : a));
        return (
          <g>
            <path d={`M${x + 24} ${y + 11}L${tx} ${ty}`} fill="none" class="stroke-beton-tua" stroke-width="1.6"></path>
            <path d={`M${x} ${y}h48v22h-42l-6-6z`} class="fill-beton-tua"></path>
            <text x={x + 7} y={y + 16.5} style="font:900 15px var(--font-stensil)" class="fill-semen">{id}</text>
          </g>
        );
      })
    }
    <path d="M30 304h60M30 298v12M90 298v12" fill="none" class="stroke-beton-tua" stroke-width="2"></path>
    <text x="100" y="309" style="font:600 15px var(--font-sans)" class="fill-beton-tua">1 m</text>
  </svg>
  <figcaption class="mt-3 max-w-[58ch] text-kecil">
    Contoh denah lantai gudang 6 × 4 m. Garis amber adalah retak yang sudah diinjeksi, titik adalah packer, garis putus
    adalah sambungan susut lantai. Panjang gambar mengikuti tabel di bawahnya.
  </figcaption>
</figure>
