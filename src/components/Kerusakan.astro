---
// Lima tahap dari retak halus sampai beton mengelupas (potongan melintang). Tahap 5: diperbaiki dini.
interface Props {
  tahap: 1 | 2 | 3 | 4 | 5;
  judul: string;
}
const { tahap, judul } = Astro.props;
const retak = 'M104 30L99 52L105 72L101 90';
---

<svg viewBox="0 0 200 160" role="img" aria-label={judul} class="w-full">
  <rect x="1.5" y="1.5" width="197" height="157" fill="none" stroke-width="3" style={tahap === 5 ? 'stroke:var(--color-resin)' : 'stroke:none'}></rect>
  <rect x="8" y="30" width="184" height="118" fill="url(#p-beton-terang)" class="stroke-beton-tua" stroke-width="2"></rect>
  {
    tahap === 4 && (
      <path d="M70 30h60l6 22-18 20-18 16-18-16-18-20z" class="fill-semen stroke-beton-tua" stroke-width="2" stroke-linejoin="round"></path>
    )
  }
  <circle cx="100" cy="104" r="8" class="fill-beton-tua"></circle>
  {(tahap === 3 || tahap === 4) && <circle cx="100" cy="104" r="15" fill="none" class="stroke-beton-tua" stroke-width="2" stroke-dasharray="3 2.5"></circle>}
  {tahap === 3 && <path d="M96 90L70 50M104 90L130 50" fill="none" class="stroke-beton-tua" stroke-width="1.8"></path>}
  {(tahap === 1) && <path d={retak} fill="none" class="stroke-beton-tua" stroke-width="1.8"></path>}
  {
    tahap === 2 && (
      <>
        <path d="M104 30L99 52L105 72L101 90L100 96" fill="none" class="stroke-beton-tua" stroke-width="1.8"></path>
        <path d="M95 34L92 60L96 84" fill="none" class="stroke-beton-tua" stroke-width="1.4" stroke-dasharray="2 3"></path>
        <path d="M100 4c3 5 5 8 0 11-5-3-3-6 0-11zM118 8c3 5 5 8 0 11-5-3-3-6 0-11zM84 10c3 5 5 8 0 11-5-3-3-6 0-11z" class="fill-beton-tua"></path>
      </>
    )
  }
  {
    tahap === 5 && (
      <>
        <path d={retak} fill="none" class="stroke-beton-dalam" stroke-width="6.5"></path>
        <path d={retak} fill="none" class="stroke-resin" stroke-width="3.5"></path>
        <circle cx="104" cy="30" r="7" class="fill-beton-dalam stroke-semen" stroke-width="2"></circle>
        <circle cx="104" cy="30" r="2.4" class="fill-resin"></circle>
      </>
    )
  }
</svg>
